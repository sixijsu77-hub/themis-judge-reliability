# venv
# Stage 1 uses .venv; stage 2 needs a separate one because vLLM pins an older torch.
.venv*/
venv*/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# datasets and model weights - large and re-downloadable
data/
models/
.cache/
*.safetensors
*.onnx
*.bin

# generated indexes and embeddings - reproducible from source
index/
embeddings/
*.npy
*.faiss

# results/ is committed (raw measurements, individual verdicts included).
# Upstream per-item output is excluded: it embeds a copy of the dataset and runs to
# ~16 MB per model. scripts/trim_raw_results.py converts it to results/gate/*.jsonl,
# which keeps every verdict and drops only the regenerable text.
results/eval-set-scores/
results/**/raw_dump_*.jsonl
# run logs: the measurements are in the jsonl next to them
results/*.log

# environment
.env
*.key

# local model weights and serving caches
hf_cache/
vllm_cache/
*.gguf

# not part of the published record
CLAUDE*.md
*prompt*.txt
*prompt*.md
docs/plans/
.local/

*private*
*internal*
*secret*
*_local.*
*.local.*

# upstream aggregate output; the committed record is generated from it
results/eval-set/

# watchdog state, rewritten every check
.watch_state.json*

# local agent tooling, not part of the measurement
.claude/
